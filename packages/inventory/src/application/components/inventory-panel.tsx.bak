'use client';

import { useState, useMemo } from "react";
import { InventoryItem } from "../../domain/entities/inventory-item";
import { InventoryTransaction } from "../../domain/entities/inventory-transaction";

const mockInventory: Omit<InventoryItem, "id">[] = [
  {
    sku: "INV001",
    name: "Beras Premium 10kg",
    description: "Beras premium berkualitas tinggi",
    unitPrice: 75000,
    quantity: 25,
    warehouse: "Main",
    reorderPoint: 10,
    lastRestockDate: new Date(),
  },
  {
    sku: "INV002",
    name: "Minyak Goreng 2L",
    description: "Minyak goreng premium",
    unitPrice: 28000,
    quantity: 8,
    warehouse: "Main",
    reorderPoint: 15,
    lastRestockDate: new Date(),
  },
  {
    sku: "INV003",
    name: "Gula Pasir 5kg",
    description: "Gula pasir putih",
    unitPrice: 45000,
    quantity: 12,
    warehouse: "Main",
    reorderPoint: 5,
    lastRestockDate: new Date(),
  },
  {
    sku: "INV004",
    name: "Garam Halus 1kg",
    description: "Garam halus berkualitas",
    unitPrice: 12000,
    quantity: 20,
    warehouse: "Main",
    reorderPoint: 8,
    lastRestockDate: new Date(),
  },
  {
    sku: "INV005",
    name: "Tepung Terigu 25kg",
    description: "Tepung terigu protein sedang",
    unitPrice: 35000,
    quantity: 6,
    warehouse: "Storage",
    reorderPoint: 5,
    lastRestockDate: new Date(),
  },
];

export function InventoryPanel() {
  const [inventory, setInventory] = useState<Omit<InventoryItem, "id">[]>(mockInventory);
  const [transactions, setTransactions] = useState<Omit<InventoryTransaction, "id">[]>([]);
  const [selectedView, setSelectedView] = useState<"stock" | "transactions">("stock");
  const [selectedItem, setSelectedItem] = useState<Omit<InventoryItem, "id"> | null>(null);
  const [transactionQty, setTransactionQty] = useState<number>(0);
  const [message, setMessage] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const totalValue = useMemo(() => inventory.reduce((sum, item) => sum + item.totalValue, 0), [inventory]);

  const needsReorder = useMemo(
    () => inventory.filter((item) => item.needsReorder),
    [inventory]
  );

  const handleStockIn = (item: Omit<InventoryItem, "id">, qty: number) => {
    if (qty <= 0) {
      setMessage({ type: "error", text: "Quantity harus lebih dari 0" });
      return;
    }

    const updated = inventory.map((inv) => {
      if (inv.sku === item.sku) {
        inv.quantity += qty;
      }
      return inv;
    });

    const transaction: Omit<InventoryTransaction, "id"> = {
      transactionType: "stock-in",
      itemSku: item.sku,
      itemName: item.name,
      quantity: qty,
      reference: `STOCK-IN-${Date.now()}`,
      notes: `Manual stock in untuk ${item.name}`,
      createdAt: new Date(),
      createdBy: "Admin",
    };

    setInventory(updated);
    setTransactions([transaction, ...transactions]);
    setSelectedItem(null);
    setTransactionQty(0);
    setMessage({ type: "success", text: `Stock in untuk ${item.name} berhasil` });
    setTimeout(() => setMessage(null), 2000);
  };

  const handleStockOut = (item: Omit<InventoryItem, "id">, qty: number) => {
    if (qty <= 0) {
      setMessage({ type: "error", text: "Quantity harus lebih dari 0" });
      return;
    }

    if (item.quantity < qty) {
      setMessage({ type: "error", text: `Stock tidak cukup. Available: ${item.quantity}` });
      return;
    }

    const updated = inventory.map((inv) => {
      if (inv.sku === item.sku) {
        inv.quantity -= qty;
      }
      return inv;
    });

    const transaction: Omit<InventoryTransaction, "id"> = {
      transactionType: "stock-out",
      itemSku: item.sku,
      itemName: item.name,
      quantity: qty,
      reference: `STOCK-OUT-${Date.now()}`,
      notes: `Manual stock out dari ${item.name}`,
      createdAt: new Date(),
      createdBy: "Admin",
    };

    setInventory(updated);
    setTransactions([transaction, ...transactions]);
    setSelectedItem(null);
    setTransactionQty(0);
    setMessage({ type: "success", text: `Stock out dari ${item.name} berhasil` });
    setTimeout(() => setMessage(null), 2000);
  };

  return (
    <section className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div className="mb-6 flex flex-col gap-2">
        <p className="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">Inventory Management</p>
        <h2 className="text-2xl font-semibold text-slate-900">Manajemen Persediaan</h2>
        <p className="text-sm text-slate-600">Tracking persediaan, alert reorder, dan history transaksi</p>
      </div>

      <div className="mb-6 grid gap-3 sm:grid-cols-3">
        <div className="rounded-lg bg-indigo-50 p-4">
          <p className="text-xs font-semibold uppercase text-indigo-600">Total Inventory Value</p>
          <p className="text-2xl font-bold text-indigo-900">Rp {totalValue.toLocaleString("id-ID")}</p>
        </div>
        <div className="rounded-lg bg-orange-50 p-4">
          <p className="text-xs font-semibold uppercase text-orange-600">Items</p>
          <p className="text-2xl font-bold text-orange-900">{inventory.length}</p>
        </div>
        <div className="rounded-lg bg-red-50 p-4">
          <p className="text-xs font-semibold uppercase text-red-600">Needs Reorder</p>
          <p className="text-2xl font-bold text-red-900">{needsReorder.length}</p>
        </div>
      </div>

      <div className="mb-4 flex gap-2 border-b border-slate-200">
        <button
          onClick={() => setSelectedView("stock")}
          className={`px-4 py-2 font-medium transition ${
            selectedView === "stock"
              ? "border-b-2 border-indigo-600 text-indigo-600"
              : "text-slate-600 hover:text-slate-900"
          }`}
        >
          Stock Levels
        </button>
        <button
          onClick={() => setSelectedView("transactions")}
          className={`px-4 py-2 font-medium transition ${
            selectedView === "transactions"
              ? "border-b-2 border-indigo-600 text-indigo-600"
              : "text-slate-600 hover:text-slate-900"
          }`}
        >
          Transactions ({transactions.length})
        </button>
      </div>

      {selectedView === "stock" ? (
        <div className="space-y-3">
          {needsReorder.length > 0 && (
            <div className="rounded-lg border border-red-200 bg-red-50 p-3">
              <p className="text-sm font-semibold text-red-900">⚠️ {needsReorder.length} items need reorder</p>
              <p className="text-xs text-red-700 mt-1">{needsReorder.map((item) => item.name).join(", ")}</p>
            </div>
          )}

          <div className="grid gap-2 max-h-96 overflow-y-auto">
            {inventory.map((item) => (
              <div
                key={item.sku}
                className={`rounded-lg border p-3 cursor-pointer transition ${
                  selectedItem?.sku === item.sku
                    ? "border-indigo-400 bg-indigo-50"
                    : "border-slate-200 hover:border-indigo-300"
                } ${item.needsReorder ? "ring-1 ring-red-300" : ""}`}
                onClick={() => setSelectedItem(item)}
              >
                <div className="flex items-start justify-between mb-2">
                  <div>
                    <p className="font-semibold text-slate-900">{item.name}</p>
                    <p className="text-xs text-slate-500">{item.sku} • {item.warehouse}</p>
                  </div>
                  {item.needsReorder && <span className="text-xs font-bold text-red-600">LOW STOCK</span>}
                </div>

                <div className="grid grid-cols-3 gap-2 text-sm">
                  <div>
                    <p className="text-xs text-slate-600">Quantity</p>
                    <p className="font-bold text-slate-900">{item.quantity}</p>
                  </div>
                  <div>
                    <p className="text-xs text-slate-600">Unit Price</p>
                    <p className="font-semibold text-slate-900">Rp {item.unitPrice.toLocaleString("id-ID")}</p>
                  </div>
                  <div>
                    <p className="text-xs text-slate-600">Total Value</p>
                    <p className="font-bold text-indigo-600">Rp {item.totalValue.toLocaleString("id-ID")}</p>
                  </div>
                </div>

                {selectedItem?.sku === item.sku && (
                  <div className="mt-3 pt-3 border-t border-slate-200 space-y-2">
                    <input
                      type="number"
                      min="1"
                      value={transactionQty}
                      onChange={(e) => setTransactionQty(Number.parseInt(e.target.value, 10))}
                      placeholder="Quantity"
                      className="w-full rounded border border-slate-300 px-2 py-1 text-sm"
                    />
                    <div className="grid grid-cols-2 gap-2">
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          handleStockIn(item, transactionQty);
                        }}
                        className="rounded bg-emerald-600 px-2 py-1 text-xs font-semibold text-white hover:bg-emerald-700 transition"
                      >
                        Stock In
                      </button>
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          handleStockOut(item, transactionQty);
                        }}
                        className="rounded bg-blue-600 px-2 py-1 text-xs font-semibold text-white hover:bg-blue-700 transition"
                      >
                        Stock Out
                      </button>
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div className="max-h-96 overflow-y-auto space-y-2">
          {transactions.length === 0 ? (
            <p className="text-center text-sm text-slate-500">No transactions yet</p>
          ) : (
            transactions.map((trans, idx) => (
              <div key={idx} className="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm">
                <div className="flex items-center justify-between mb-1">
                  <span className={`font-semibold ${
                    trans.transactionType === "stock-in" ? "text-emerald-600" :
                    trans.transactionType === "stock-out" ? "text-blue-600" : "text-slate-600"
                  }`}>
                    {trans.transactionType === "stock-in" ? "📥 Stock In" :
                     trans.transactionType === "stock-out" ? "📤 Stock Out" : "⚙️ Adjustment"}
                  </span>
                  <span className="text-xs text-slate-500">{trans.createdAt.toLocaleTimeString("id-ID")}</span>
                </div>
                <p className="text-slate-700">{trans.itemName} • {trans.quantity} unit</p>
                <p className="text-xs text-slate-600 mt-1">{trans.reference}</p>
              </div>
            ))
          )}
        </div>
      )}

      {message && (
        <div
          className={`mt-3 rounded-lg border px-3 py-2 text-sm ${
            message.type === "success"
              ? "border-emerald-200 bg-emerald-50 text-emerald-700"
              : "border-red-200 bg-red-50 text-red-700"
          }`}
        >
          {message.text}
        </div>
      )}
    </section>
  );
}
