generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roleId    Int

  role      Role     @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
}

enum TicketType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

model Ticket {
  id        Int      @id @default(autoincrement())
  name      String
  type      TicketType
  price     Int
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

