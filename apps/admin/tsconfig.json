{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "./*"
      ],
      "@satset/*": [
        "../../packages/*/src"
      ]
    },

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "generated"
  ]
}
