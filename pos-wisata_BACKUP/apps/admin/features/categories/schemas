import { z } from 'zod';

export const categorySchema = z.object({
  id: z.number().int().positive().optional(),
  name: z.string().min(1, 'Name is required').max(100, 'Name must be at most 100 characters long'),
});

export const categoryFormSchema = z.object({
  name: z.string().min(1, 'Name is required').max(100, 'Name must be at most 100 characters long'),
});