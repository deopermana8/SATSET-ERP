

export class UsersController {
  constructor(private readonly service = new (class {})()) {}

  async list() {
    return {
      resource: "User",
      routes: ["GET /projects","POST /projects"],
      useCases: ["Create project","Approve request"],
    };
  }

  async create(input: Record<string, unknown>) {
    return { ok: true, input, resource: "users" };
  }
}
